# ThreatLens Environment Configuration

# Application
APP_NAME=ThreatLens
APP_ENV=development
DEBUG=false
SECRET_KEY=threatlens-insecure-secret-key-change-in-production-min32chars
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM=HS256

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000"]

# Database
# Production MySQL URL format: mysql+aiomysql://user:password@localhost:3306/threatlens
# Local/Testing SQLite fallback: sqlite+aiosqlite:///./threatlens.db
DATABASE_URL=sqlite+aiosqlite:///./threatlens.db
DB_ECHO=false

# Ingestion Pipeline
MAX_PAYLOAD_SIZE_BYTES=10485760
DEFAULT_BATCH_SIZE=500
MAX_BATCH_SIZE=2000
WORKER_CONCURRENCY=4
MAX_INGESTION_RETRIES=3

# Groq AI Investigation (Optional)
# If left empty, ThreatLens uses deterministic rule & evidence-based investigation
GROQ_API_KEY=
GROQ_MODEL=llama3-70b-8192
GROQ_TIMEOUT_SECONDS=30

# Initial Admin User (Created automatically if not present)
ADMIN_USERNAME=soc_admin
ADMIN_EMAIL=admin@threatlens.internal
ADMIN_PASSWORD=ThreatLens@Admin2026!
